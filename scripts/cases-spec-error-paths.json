        { "name": "0 is even", "input": [0], "expectedOutput": true },
        { "name": "mod: 7 modulo 3 = 1", "entry": "mod", "input": [7, 3], "expectedOutput": 1 },
        { "name": "mod: 7 modulo 0 → 两引擎都必须拒绝", "entry": "mod", "input": [7, 0], "expectError": true },
        { "name": "mod: 0 modulo 0 → 两引擎都必须拒绝", "entry": "mod", "input": [0, 0], "expectError": true }
      ]
    },
    {
