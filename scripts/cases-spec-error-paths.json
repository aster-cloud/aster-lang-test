        { "name": "反向区间 = -60", "input": ["2024-03-01", "2024-01-01"], "expectedOutput": -60 },
        { "name": "同日 = 0", "input": ["2024-01-01", "2024-01-01"], "expectedOutput": 0 },
        { "name": "闰年 2024-02-28 → 03-01 = 2", "input": ["2024-02-28", "2024-03-01"], "expectedOutput": 2 },
        { "name": "跨年 2023-12-31 → 2024-01-01 = 1", "input": ["2023-12-31", "2024-01-01"], "expectedOutput": 1 },
        { "name": "parseDate: 非 ISO 串 → 两引擎都必须拒绝", "entry": "parseDate", "input": ["not-a-date"], "expectError": true },
        { "name": "parseDate: 月/日越界 2026-13-45 → 两引擎都必须拒绝", "entry": "parseDate", "input": ["2026-13-45"], "expectError": true },
