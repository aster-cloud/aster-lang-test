{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aster-lang.cloud/schema/policy-package/cli-stdout-1.0.json",
  "title": "aster CLI stdout, package format 1.0",
  "description": "两个 aster CLI 各子命令的 stdout 形状（一行值规范 JSON + \\n；ADR 0059 §4.1 + 修订 1 A0）。run / inspect 失败时都输出 RunError；verify 失败时输出 Verify（ok:false）。错误码与 message 的对应见 exit-codes.json（message 必须逐字等于该表）。字段语义与 meta 的取值时机见 README.md「输出」一节。",
  "oneOf": [
    {
      "$ref": "#/$defs/RunOk"
    },
    {
      "$ref": "#/$defs/RunError"
    },
    {
      "$ref": "#/$defs/Verify"
    },
    {
      "$ref": "#/$defs/Inspect"
    },
    {
      "$ref": "#/$defs/Version"
    }
  ],
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "ErrorCode": {
      "enum": [
        "EVAL_ERROR",
        "PROBE_MISMATCH",
        "INPUT_INVALID",
        "ENTRY_NOT_FOUND",
        "USAGE",
        "PKG_INTEGRITY",
        "PKG_SIGNATURE",
        "PKG_UNSIGNED",
        "PKG_UNTRUSTED_KID",
        "PKG_INVALID_MANIFEST",
        "PKG_UNSUPPORTED_FORMAT",
        "PKG_UNSUPPORTED_IR",
        "PKG_IR_DRIFT",
        "COMPILE_ERROR",
        "TIMEOUT",
        "RESOURCE_EXHAUSTED"
      ]
    },
    "Meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signed",
        "entry",
        "coreIrSha256",
        "engine",
        "cliVersion",
        "irRecompiled"
      ],
      "properties": {
        "signed": {
          "type": "boolean"
        },
        "entry": {
          "type": [
            "string",
            "null"
          ]
        },
        "coreIrSha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Sha256"
            }
          ]
        },
        "engine": {
          "description": "实际输出为 aster-lang-ts-interpreter 或 aster-lang-truffle；夹具的 expectedStdout 中为归一占位符 <ENGINE>。",
          "enum": [
            "aster-lang-ts-interpreter",
            "aster-lang-truffle",
            "<ENGINE>"
          ]
        },
        "cliVersion": {
          "type": "string",
          "minLength": 1
        },
        "irRecompiled": {
          "type": "boolean"
        }
      }
    },
    "RunOk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "value",
        "meta"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "value": {
          "description": "求值结果的值规范 JSON（VALUE-FORMS.md）。"
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        }
      }
    },
    "RunError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "error",
        "meta"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "$ref": "#/$defs/ErrorCode"
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        }
      }
    },
    "Check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "ok"
      ],
      "properties": {
        "name": {
          "enum": [
            "schema",
            "signature",
            "integrity",
            "ir",
            "recompile",
            "probes"
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        }
      },
      "if": {
        "type": "object",
        "properties": {
          "ok": {
            "const": false
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {}
        }
      },
      "else": {
        "not": {
          "type": "object",
          "required": [
            "code"
          ],
          "properties": {
            "code": {}
          }
        }
      }
    },
    "Verify": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "checks",
        "meta"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Check"
          }
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        }
      }
    },
    "Inspect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "inspect",
        "meta"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "inspect": {
          "description": "manifest 的 effects、governance、policy、runtime、tests 五个成员原样，另加 schemas：包内 schema/input.json 与 schema/output.json 的内容（ADR 0059 §4.1「打印入口、输入输出 schema」）。",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effects",
            "governance",
            "policy",
            "runtime",
            "schemas",
            "tests"
          ],
          "properties": {
            "effects": {
              "type": "object"
            },
            "governance": {
              "type": "object"
            },
            "policy": {
              "type": "object"
            },
            "runtime": {
              "type": "object"
            },
            "tests": {
              "type": "object"
            },
            "schemas": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input",
                "output"
              ],
              "properties": {
                "input": {
                  "type": "object"
                },
                "output": {
                  "type": "object"
                }
              }
            }
          }
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        }
      }
    },
    "Version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cliVersion",
        "engine",
        "formatVersions",
        "coreIrVersions",
        "toolchainId",
        "trustAnchorKids"
      ],
      "properties": {
        "cliVersion": {
          "type": "string",
          "minLength": 1
        },
        "engine": {
          "enum": [
            "aster-lang-ts-interpreter",
            "aster-lang-truffle"
          ]
        },
        "formatVersions": {
          "const": [
            "1.0"
          ]
        },
        "coreIrVersions": {
          "const": [
            2
          ]
        },
        "toolchainId": {
          "type": "string",
          "minLength": 1
        },
        "trustAnchorKids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
