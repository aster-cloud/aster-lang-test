{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aster-lang.cloud/schema/policy-package/manifest-1.0.json",
  "title": "Aster policy package manifest, formatVersion 1.0",
  "description": "aster-policy-package/v1 的 manifest.json 严格 schema（ADR 0059 §3 + 修订 1 A2）。唯一真相源在 aster-lang-test conformance/package-v1/schema/，aster-lang-ts 与 aster-lang-truffle 各存逐字节副本并以兄弟仓 parity 测试守住。每层 additionalProperties:false；键只允许 ASCII 字母数字与下划线；数字只允许整数。schema 之外的规则（规范字节、formatVersion 先判、Core IR 版本、files[] 与包内文件一致）见 conformance/package-v1/README.md。",
  "$ref": "#/$defs/Manifest",
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "NonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "StringSet": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/NonEmptyString"
      },
      "uniqueItems": true
    },
    "PackagePath": {
      "description": "包根下的相对路径：段只含 [A-Za-z0-9._-]，无 . / .. 段，不得是三个元文件。",
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
      "not": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "(^|/)\\.\\.?(/|$)"
          },
          {
            "enum": [
              "manifest.json",
              "manifest.sig.json",
              "SHA256SUMS"
            ]
          }
        ]
      }
    },
    "Entry": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_]+$"
      },
      "required": [
        "function",
        "default",
        "inputSchema",
        "outputSchema"
      ],
      "properties": {
        "function": {
          "$ref": "#/$defs/Identifier"
        },
        "default": {
          "type": "boolean"
        },
        "inputSchema": {
          "type": "string",
          "pattern": "^#/"
        },
        "outputSchema": {
          "type": "string",
          "pattern": "^#/"
        }
      }
    },
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_]+$"
      },
      "required": [
        "moduleName",
        "entries",
        "ruleId",
        "profile",
        "controls"
      ],
      "properties": {
        "moduleName": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Entry"
          },
          "contains": {
            "type": "object",
            "properties": {
              "default": {
                "const": true
              }
            },
            "required": [
              "default"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        "ruleId": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "controls": {
          "$ref": "#/$defs/StringSet"
        }
      }
    },
    "ClaimedRef": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_]+$"
      },
      "required": [
        "policyId",
        "version",
        "status",
        "approvedAt"
      ],
      "properties": {
        "policyId": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "approvedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_]+$"
      },
      "required": [
        "claimedRef",
        "sha256",
        "locale",
        "allowStructural",
        "envelopeSha256"
      ],
      "properties": {
        "claimedRef": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/ClaimedRef"
            }
          ]
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}-[A-Z]{2}$"
        },
        "allowStructural": {
          "type": "boolean"
        },
        "envelopeSha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "CoreIr": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_]+$"
      },
      "required": [
        "version",
        "sha256",
        "positionFreeSha256",
        "toolchainId"
      ],
      "properties": {
        "version": {
          "description": "Core IR 版本。schema 只要求正整数；CLI 不支持的版本（v1 CLI 只支持 2）在 schema 之后以 PKG_UNSUPPORTED_IR 拒绝。",
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "positionFreeSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "toolchainId": {
          "$ref": "#/$defs/NonEmptyString"
        }
      }
    },
    "Effects": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_]+$"
      },
      "required": [
        "declared",
        "io"
      ],
      "properties": {
        "declared": {
          "$ref": "#/$defs/StringSet"
        },
        "io": {
          "type": "boolean"
        }
      }
    },
    "Governance": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_]+$"
      },
      "required": [
        "enforced",
        "verdict",
        "factSources"
      ],
      "properties": {
        "enforced": {
          "const": false
        },
        "verdict": {
          "type": "boolean"
        },
        "factSources": {
          "$ref": "#/$defs/StringSet"
        }
      }
    },
    "Cli": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_]+$"
      },
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "enum": [
            "@aster-cloud/aster-lang-ts",
            "cloud.aster-lang:aster-cli"
          ]
        },
        "version": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "Runtime": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_]+$"
      },
      "required": [
        "engine",
        "cli",
        "requires",
        "ecosystem"
      ],
      "properties": {
        "engine": {
          "enum": [
            "aster-lang-ts-interpreter",
            "aster-lang-truffle"
          ]
        },
        "cli": {
          "$ref": "#/$defs/Cli"
        },
        "requires": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+$"
          },
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "node"
              ],
              "properties": {
                "node": {
                  "$ref": "#/$defs/NonEmptyString"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "java"
              ],
              "properties": {
                "java": {
                  "$ref": "#/$defs/NonEmptyString"
                }
              }
            }
          ]
        },
        "ecosystem": {
          "$ref": "#/$defs/NonEmptyString"
        }
      }
    },
    "NodeCheck": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_]+$"
      },
      "required": [
        "checkedBy",
        "tsVersion",
        "agreed"
      ],
      "properties": {
        "checkedBy": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "tsVersion": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "agreed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Tests": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_]+$"
      },
      "required": [
        "probes",
        "probesSha256",
        "nodeCheck"
      ],
      "properties": {
        "probes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "probesSha256": {
          "$ref": "#/$defs/Sha256"
        },
        "nodeCheck": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/NodeCheck"
            }
          ]
        }
      }
    },
    "FileEntry": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_]+$"
      },
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/PackagePath"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ExportedBy": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_]+$"
      },
      "required": [
        "issuer",
        "tenantId"
      ],
      "properties": {
        "issuer": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "tenantId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Manifest": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_]+$"
      },
      "required": [
        "format",
        "formatVersion",
        "target",
        "mode",
        "policy",
        "source",
        "coreIr",
        "effects",
        "governance",
        "runtime",
        "tests",
        "files",
        "exportedBy"
      ],
      "properties": {
        "format": {
          "const": "aster-policy-package"
        },
        "formatVersion": {
          "const": "1.0"
        },
        "target": {
          "enum": [
            "node",
            "jre"
          ]
        },
        "mode": {
          "enum": [
            "a",
            "b"
          ]
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "coreIr": {
          "$ref": "#/$defs/CoreIr"
        },
        "effects": {
          "$ref": "#/$defs/Effects"
        },
        "governance": {
          "$ref": "#/$defs/Governance"
        },
        "runtime": {
          "$ref": "#/$defs/Runtime"
        },
        "tests": {
          "$ref": "#/$defs/Tests"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/FileEntry"
          },
          "allOf": [
            {
              "type": "array",
              "contains": {
                "type": "object",
                "properties": {
                  "path": {
                    "const": "policy/policy.aster"
                  }
                },
                "required": [
                  "path"
                ]
              }
            },
            {
              "type": "array",
              "contains": {
                "type": "object",
                "properties": {
                  "path": {
                    "const": "policy/compile/alias-set.json"
                  }
                },
                "required": [
                  "path"
                ]
              }
            },
            {
              "type": "array",
              "contains": {
                "type": "object",
                "properties": {
                  "path": {
                    "const": "schema/input.json"
                  }
                },
                "required": [
                  "path"
                ]
              }
            },
            {
              "type": "array",
              "contains": {
                "type": "object",
                "properties": {
                  "path": {
                    "const": "schema/output.json"
                  }
                },
                "required": [
                  "path"
                ]
              }
            },
            {
              "type": "array",
              "contains": {
                "type": "object",
                "properties": {
                  "path": {
                    "const": "tests/probes.json"
                  }
                },
                "required": [
                  "path"
                ]
              }
            }
          ],
          "description": "载荷清单（不含三个元文件）。必含 policy/policy.aster、policy/compile/alias-set.json、schema/input.json、schema/output.json、tests/probes.json；A 另含 compiled/core.json，B 不得含 compiled/ 下的文件。路径唯一、按 UTF-8 字节序升序由 CLI 校验（schema 无法表达）。"
        },
        "exportedBy": {
          "$ref": "#/$defs/ExportedBy"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "mode": {
                "const": "a"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "runtime": {
                "type": "object",
                "properties": {
                  "cli": {
                    "type": "object",
                    "required": [
                      "sha256"
                    ],
                    "properties": {
                      "sha256": {}
                    }
                  }
                }
              },
              "files": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "const": "compiled/core.json"
                    }
                  },
                  "required": [
                    "path"
                  ]
                }
              }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "runtime": {
                "type": "object",
                "properties": {
                  "cli": {
                    "not": {
                      "type": "object",
                      "required": [
                        "sha256"
                      ],
                      "properties": {
                        "sha256": {}
                      }
                    }
                  }
                }
              },
              "files": {
                "not": {
                  "type": "array",
                  "contains": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^compiled/"
                      }
                    },
                    "required": [
                      "path"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "target": {
                "const": "node"
              }
            },
            "required": [
              "target"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "runtime": {
                "type": "object",
                "properties": {
                  "engine": {
                    "const": "aster-lang-ts-interpreter"
                  },
                  "cli": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "const": "@aster-cloud/aster-lang-ts"
                      }
                    }
                  },
                  "requires": {
                    "type": "object",
                    "required": [
                      "node"
                    ],
                    "properties": {
                      "node": {}
                    }
                  }
                }
              }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "runtime": {
                "type": "object",
                "properties": {
                  "engine": {
                    "const": "aster-lang-truffle"
                  },
                  "cli": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "const": "cloud.aster-lang:aster-cli"
                      }
                    }
                  },
                  "requires": {
                    "type": "object",
                    "required": [
                      "java"
                    ],
                    "properties": {
                      "java": {}
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
