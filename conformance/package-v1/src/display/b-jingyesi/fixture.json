{
  "description": "B 包，zh-CN，《静夜思》（ADR 0060 §8 的源码 / aliasSet / 词汇含字面量宏 思故乡 → \"静夜思\"，allowStructural=true；cloud JINGYESI_LAYOUT），formatVersion 1.1 + display（ADR 0059 修订 4）。run 得 静夜思；show 打印原诗；run --display 按 D7 还原改过的显示文本后运行。platform-core.json 为 aster-cli 1.0.52 compile 的输出，与 aster-api 导出的 jingyesi-jre-b 包 coreIr.sha256 逐字节相同（dc80881a…）。",
  "mode": "b",
  "target": "jre",
  "locale": "zh-CN",
  "aliasSet": { "FUNC_PRODUCE": ["举头"], "FUNC_TO": ["疑是"], "MODULE_DECL": ["床前"], "RETURN": ["低头"] },
  "allowStructural": true,
  "vocabulary": true,
  "claimedRefVersion": 1,
  "entries": [{ "function": "地上霜", "default": true }],
  "probes": [{ "entry": "地上霜", "input": {} }],
  "cases": [
    { "name": "run", "command": "run", "input": {}, "value": "\"静夜思\"" },
    { "name": "verify", "command": "verify" },
    { "name": "verify-recompile-probes", "command": "verify", "args": ["--recompile", "--probes"] },
    { "name": "inspect", "command": "inspect" },
    { "name": "show", "command": "show" },
    { "name": "show-canonical", "command": "show", "args": ["--canonical"] },
    { "name": "show-from-display-last-line-literal", "command": "show", "fromDisplay": "last-line-literal.txt" },
    { "name": "show-from-display-unchanged", "command": "show", "fromDisplay": "unchanged.txt" },
    { "name": "show-from-display-ambiguous", "command": "show", "fromDisplay": "repeat-prefix.txt", "reconstruct": "ambiguous", "expect": { "code": "DISPLAY_AMBIGUOUS" } },
    { "name": "run-display-unchanged", "command": "run", "display": "unchanged.txt", "input": {}, "value": "\"静夜思\"", "matchesPackage": true },
    { "name": "run-display-trailing-newline", "command": "run", "display": "trailing-newline.txt", "input": {}, "value": "\"静夜思\"", "matchesPackage": true },
    { "name": "run-display-bom-trailing-crlf", "command": "run", "display": "bom-trailing-crlf.txt", "input": {}, "value": "\"静夜思\"", "matchesPackage": true },
    { "name": "run-display-last-line-literal", "command": "run", "display": "last-line-literal.txt", "input": {}, "value": "\"月光\"", "matchesPackage": false },
    { "name": "run-display-first-line-edit", "command": "run", "display": "first-line-edit.txt", "input": {}, "value": "\"静夜思\"", "matchesPackage": false },
    { "name": "run-display-both-sides", "command": "run", "display": "both-sides.txt", "input": {}, "reconstruct": "unmappable", "expect": { "code": "DISPLAY_UNMAPPABLE" } },
    { "name": "run-display-repeat-prefix", "command": "run", "display": "repeat-prefix.txt", "input": {}, "reconstruct": "ambiguous", "expect": { "code": "DISPLAY_AMBIGUOUS" } },
    { "name": "run-display-punct-changed", "command": "run", "display": "punct-changed.txt", "input": {}, "reconstruct": "unmappable", "expect": { "code": "DISPLAY_UNMAPPABLE" } },
    { "name": "run-display-oversize", "command": "run", "display": "oversize.txt", "input": {}, "reconstruct": "unmappable", "expect": { "code": "DISPLAY_UNMAPPABLE" } },
    { "name": "run-display-crlf", "command": "run", "display": "crlf.txt", "input": {}, "reconstruct": "unmappable", "expect": { "code": "DISPLAY_UNMAPPABLE" } },
    { "name": "display-entry-renamed", "command": "run", "display": "entry-renamed.txt", "input": {}, "matchesPackage": false, "expect": { "code": "ENTRY_NOT_FOUND" } },
    { "name": "run-display-compile-error", "command": "run", "display": "compile-error.txt", "input": {}, "matchesPackage": false, "expect": { "code": "COMPILE_ERROR" } },
    { "name": "usage-display-invalid-utf8", "rawArgs": ["run", "{pkg}", "--display", "{edits}/invalid-utf8.txt", "--input", "-", "--jwks", "../../keys/test-jwks.json"], "expect": { "code": "USAGE" } },
    { "name": "usage-display-missing-file", "rawArgs": ["run", "{pkg}", "--display", "{edits}/no-such-file.txt", "--input", "-", "--jwks", "../../keys/test-jwks.json"], "expect": { "code": "USAGE" } },
    { "name": "usage-show-canonical-and-from-display", "rawArgs": ["show", "{pkg}", "--canonical", "--from-display", "{edits}/unchanged.txt", "--jwks", "../../keys/test-jwks.json"], "expect": { "code": "USAGE" } },
    { "name": "usage-show-from-display-missing-file", "rawArgs": ["show", "{pkg}", "--from-display", "{edits}/no-such-file.txt", "--jwks", "../../keys/test-jwks.json"], "expect": { "code": "USAGE" } },
    { "name": "usage-show-rejects-input", "rawArgs": ["show", "{pkg}", "--input", "-", "--jwks", "../../keys/test-jwks.json"], "expect": { "code": "USAGE" } },
    { "name": "usage-show-rejects-entry", "rawArgs": ["show", "{pkg}", "--entry", "地上霜", "--jwks", "../../keys/test-jwks.json"], "expect": { "code": "USAGE" } },
    { "name": "usage-show-no-package", "rawArgs": ["show", "--jwks", "../../keys/test-jwks.json"], "expect": { "code": "USAGE" } },
    { "name": "usage-verify-rejects-display", "rawArgs": ["verify", "{pkg}", "--display", "{edits}/unchanged.txt", "--jwks", "../../keys/test-jwks.json"], "expect": { "code": "USAGE" } },
    { "name": "usage-run-display-twice", "rawArgs": ["run", "{pkg}", "--display", "{edits}/unchanged.txt", "--display", "{edits}/unchanged.txt", "--input", "-", "--jwks", "../../keys/test-jwks.json"], "expect": { "code": "USAGE" } }
  ]
}
