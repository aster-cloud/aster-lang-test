{
  "description": "显示排版的篡改夹具（ADR 0059 修订 4、修订 5；派生自 display/packages/b-jingyesi 与 b-display-escape，全部重新签名）。普通 run 不检查排版；verify 在 display（L1–L7）或 display-ir（L8–L9，仅 --recompile）检查项失败；show 先过 L1–L7。",
  "requiresFormat": "1.1",
  "cases": [
    {
      "name": "display-text-tampered-resigned",
      "base": "b-jingyesi",
      "requiresFormat": "1.1",
      "args": [
        "run",
        "display-text-tampered-resigned",
        "--input",
        "-",
        "--jwks",
        "../../keys/test-jwks.json"
      ],
      "stdin": "{}",
      "expectedStdout": "{\"meta\":{\"cliVersion\":\"<CLI_VERSION>\",\"coreIrSha256\":\"dc80881aada226c7c489ae26cd42d10c7b30e7fd82983360368f65d1fa477032\",\"engine\":\"<ENGINE>\",\"entry\":\"地上霜\",\"irRecompiled\":true,\"signed\":true},\"ok\":true,\"value\":\"静夜思\"}\n",
      "expectedExit": 0,
      "code": null
    },
    {
      "name": "display-text-tampered-resigned (verify)",
      "base": "b-jingyesi",
      "requiresFormat": "1.1",
      "args": [
        "verify",
        "display-text-tampered-resigned",
        "--jwks",
        "../../keys/test-jwks.json"
      ],
      "expectedStdout": "{\"checks\":[{\"name\":\"schema\",\"ok\":true},{\"name\":\"signature\",\"ok\":true},{\"name\":\"integrity\",\"ok\":true},{\"code\":\"PKG_DISPLAY_INVALID\",\"name\":\"display\",\"ok\":false}],\"meta\":{\"cliVersion\":\"<CLI_VERSION>\",\"coreIrSha256\":\"dc80881aada226c7c489ae26cd42d10c7b30e7fd82983360368f65d1fa477032\",\"engine\":\"<ENGINE>\",\"entry\":\"地上霜\",\"irRecompiled\":false,\"signed\":true},\"ok\":false}\n",
      "expectedExit": 4,
      "code": "PKG_DISPLAY_INVALID"
    },
