      "expectedStdout": "{\"checks\":[{\"name\":\"schema\",\"ok\":true},{\"name\":\"signature\",\"ok\":true},{\"name\":\"integrity\",\"ok\":true},{\"code\":\"PKG_DISPLAY_INVALID\",\"name\":\"display\",\"ok\":false}],\"meta\":{\"cliVersion\":\"<CLI_VERSION>\",\"coreIrSha256\":\"dc80881aada226c7c489ae26cd42d10c7b30e7fd82983360368f65d1fa477032\",\"engine\":\"<ENGINE>\",\"entry\":\"地上霜\",\"irRecompiled\":false,\"signed\":true},\"ok\":false}\n",
