Rule testPerfectDriverNewCar, produce:
  Let driver be Driver with driverId set to "D7", age set to 55, yearsLicensed set to 37, accidentCount set to 0, violationCount set to 0, creditScore set to 800.
  Let vehicle be Vehicle with vin set to "V7", year set to 2026, make set to "Subaru", model set to "Outback", value set to 35000, safetyRating set to 5.
  Let quote be generateAutoQuote(driver, vehicle, "premium").
  Return quote.monthlyPremium.
Rule testHighRiskDriverOldCar, produce:
  Let driver be Driver with driverId set to "D8", age set to 30, yearsLicensed set to 12, accidentCount set to 2, violationCount set to 2, creditScore set to 550.
  Let vehicle be Vehicle with vin set to "V8", year set to 2008, make set to "Ford", model set to "Focus", value set to 4000, safetyRating set to 3.
  Let quote be generateAutoQuote(driver, vehicle, "basic").
  Return quote.monthlyPremium.
Rule testLowCreditScore, produce:
  Let driver be Driver with driverId set to "D9", age set to 40, yearsLicensed set to 22, accidentCount set to 0, violationCount set to 0, creditScore set to 550.
  Let vehicle be Vehicle with vin set to "V9", year set to 2020, make set to "Honda", model set to "Accord", value set to 20000, safetyRating set to 5.
  Let quote be generateAutoQuote(driver, vehicle, "standard").
  Return quote.deductible.
Rule testHighValueVehicle, produce:
  Let driver be Driver with driverId set to "D10", age set to 45, yearsLicensed set to 27, accidentCount set to 0, violationCount set to 0, creditScore set to 780.
  Let vehicle be Vehicle with vin set to "V10", year set to 2026, make set to "BMW", model set to "M5", value set to 120000, safetyRating set to 4.
  Let quote be generateAutoQuote(driver, vehicle, "premium").
  Return quote.coverageLimit.
Rule testOldVehicle, produce:
  Let vehicle be Vehicle with vin set to "V11", year set to 2005, make set to "Ford", model set to "Taurus", value set to 2500, safetyRating set to 3.
  Return calculateVehicleFactor(vehicle).
Rule testCalculateAgeFactorYoung, produce:
  Return calculateAgeFactor(19).
Rule testCalculateAgeFactorMiddle, produce:
  Return calculateAgeFactor(40).
Rule testCalculateAgeFactorSenior, produce:
  Return calculateAgeFactor(70).
Rule testCalculateVehicleFactorNew, produce:
  Let vehicle be Vehicle with vin set to "V12", year set to 2026, make set to "Honda", model set to "Accord", value set to 30000, safetyRating set to 5.
  Return calculateVehicleFactor(vehicle).
Rule testCalculateVehicleFactorOld, produce:
  Let vehicle be Vehicle with vin set to "V13", year set to 2010, make set to "Honda", model set to "Accord", value set to 6000, safetyRating set to 4.
  Return calculateVehicleFactor(vehicle).
Rule testCalculateRiskMultiplierClean, produce:
  Let driver be Driver with driverId set to "D11", age set to 40, yearsLicensed set to 22, accidentCount set to 0, violationCount set to 0, creditScore set to 750.
  Let vehicle be Vehicle with vin set to "V14", year set to 2020, make set to "Honda", model set to "Accord", value set to 20000, safetyRating set to 5.
  Return calculateRiskMultiplier(driver, vehicle).
Rule testCalculateRiskMultiplierHighRisk, produce:
  Let driver be Driver with driverId set to "D12", age set to 30, yearsLicensed set to 12, accidentCount set to 2, violationCount set to 2, creditScore set to 550.
  Let vehicle be Vehicle with vin set to "V15", year set to 2008, make set to "Ford", model set to "Focus", value set to 4000, safetyRating set to 3.
  Return calculateRiskMultiplier(driver, vehicle).
Rule testDetermineDeductiblePremiumHigh, produce:
  Return determineDeductible("premium", 750).
Rule testDetermineDeductibleStandardLow, produce:
  Return determineDeductible("standard", 600).
Rule testDetermineCoverageLimitPremium, produce:
  Return determineCoverageLimit("premium", 50000).
Rule testDetermineCoverageLimitBasicHighValue, produce:
  Return determineCoverageLimit("basic", 120000).
