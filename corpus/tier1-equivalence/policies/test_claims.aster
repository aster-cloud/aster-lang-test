Module test.healthcare.claims.

# 合成示例策略——数值取自公开权威来源（2026-08 检索），非真实保险产品条款。
#   · 网内/网外：KFF《ACA Marketplace 2024 拒付分析》网内拒付 19%、网外 37%
#   · coinsurance 80%：KFF 2025 雇主健康福利调查（住院 20% coinsurance）
#   · 提供者质量门槛：CMS Medicare Advantage Star Ratings（质量奖金线 3.5 星）
#   · 预授权金额阈值 1000：★KFF 明示预授权按服务类型而非金额触发，
#     此阈值是为让样本可执行而做的工程简化，无权威出处。
#   · 拒付理由枚举参考 KFF 2024 六分类（缺预授权/转诊占 9%）

Define Claim has claimId, patientId, providerId, serviceDate, amount, diagnosisCode.

Define Provider has providerId, inNetwork, specialtyType, qualityScore.

Define ClaimDecision has approved, reason, approvedAmount, denialCode, requiresReview.

Rule calculateClaimApproval given claimAmount, coverage, specialty, produce:
  If specialty equals to "surgery"
    Return (claimAmount times (coverage minus 10)) divided by 100.
  If specialty equals to "specialist"
    Return (claimAmount times (coverage minus 5)) divided by 100.
  Return (claimAmount times coverage) divided by 100.
Rule validateClaimDocumentation given claim, hasPreAuth, hasReferral, produce:
  If claim.amount at least 1000
    If hasPreAuth equals to false
      Return false.
  If hasReferral equals to false
    Return false.
  Return true.
Rule processClaim given claim, provider, patientCoverage, produce:
  If provider.inNetwork equals to false
    Return ClaimDecision with approved set to false, reason set to "Out-of-network provider", approvedAmount set to 0, denialCode set to "OON", requiresReview set to true.
  If claim.amount at least 100000
    Return ClaimDecision with approved set to false, reason set to "Amount exceeds automatic adjudication limit", approvedAmount set to 0, denialCode set to "LIMIT", requiresReview set to true.
  If provider.qualityScore less than 3
    Return ClaimDecision with approved set to false, reason set to "Provider below quality threshold", denialCode set to "QUALITY", approvedAmount set to 0, requiresReview set to true.
  Let paid be calculateClaimApproval(claim.amount, patientCoverage, provider.specialtyType).
  Return ClaimDecision with approved set to true, reason set to "Approved", approvedAmount set to paid, denialCode set to "NONE", requiresReview set to false.
Rule testOutOfNetworkProvider, produce:
  Let claim be Claim with claimId set to "C1", patientId set to "P1", providerId set to "PR1", serviceDate set to "2026-01-15", amount set to 500, diagnosisCode set to "J06".
  Let provider be Provider with providerId set to "PR1", inNetwork set to false, specialtyType set to "general", qualityScore set to 4.
  Let decision be processClaim(claim, provider, 80).
  Return decision.denialCode.
Rule testAmountExceedsLimit, produce:
  Let claim be Claim with claimId set to "C2", patientId set to "P1", providerId set to "PR2", serviceDate set to "2026-01-15", amount set to 120000, diagnosisCode set to "I21".
  Let provider be Provider with providerId set to "PR2", inNetwork set to true, specialtyType set to "surgery", qualityScore set to 5.
  Let decision be processClaim(claim, provider, 80).
  Return decision.denialCode.
Rule testLowQualityProvider, produce:
  Let claim be Claim with claimId set to "C3", patientId set to "P1", providerId set to "PR3", serviceDate set to "2026-01-15", amount set to 500, diagnosisCode set to "J06".
  Let provider be Provider with providerId set to "PR3", inNetwork set to true, specialtyType set to "general", qualityScore set to 2.
  Let decision be processClaim(claim, provider, 80).
  Return decision.denialCode.
Rule testGeneralProviderNormalClaim, produce:
  Let claim be Claim with claimId set to "C4", patientId set to "P1", providerId set to "PR4", serviceDate set to "2026-01-15", amount set to 500, diagnosisCode set to "J06".
  Let provider be Provider with providerId set to "PR4", inNetwork set to true, specialtyType set to "general", qualityScore set to 4.
  Let decision be processClaim(claim, provider, 80).
  Return decision.approvedAmount.
Rule testSpecialistProvider, produce:
  Let claim be Claim with claimId set to "C5", patientId set to "P1", providerId set to "PR5", serviceDate set to "2026-01-15", amount set to 500, diagnosisCode set to "M54".
  Let provider be Provider with providerId set to "PR5", inNetwork set to true, specialtyType set to "specialist", qualityScore set to 4.
  Let decision be processClaim(claim, provider, 80).
  Return decision.approvedAmount.
Rule testSurgeryProvider, produce:
  Let claim be Claim with claimId set to "C6", patientId set to "P1", providerId set to "PR6", serviceDate set to "2026-01-15", amount set to 500, diagnosisCode set to "K35".
  Let provider be Provider with providerId set to "PR6", inNetwork set to true, specialtyType set to "surgery", qualityScore set to 5.
  Let decision be processClaim(claim, provider, 80).
  Return decision.approvedAmount.
Rule testHighAmountInNetworkClaim, produce:
  Let claim be Claim with claimId set to "C7", patientId set to "P1", providerId set to "PR7", serviceDate set to "2026-01-15", amount set to 99000, diagnosisCode set to "K35".
  Let provider be Provider with providerId set to "PR7", inNetwork set to true, specialtyType set to "surgery", qualityScore set to 5.
  Let decision be processClaim(claim, provider, 80).
  Return decision.approvedAmount.
Rule testMinimalAmountClaim, produce:
  Let claim be Claim with claimId set to "C8", patientId set to "P1", providerId set to "PR8", serviceDate set to "2026-01-15", amount set to 100, diagnosisCode set to "Z00".
  Let provider be Provider with providerId set to "PR8", inNetwork set to true, specialtyType set to "general", qualityScore set to 4.
  Let decision be processClaim(claim, provider, 80).
  Return decision.approvedAmount.
Rule testValidDocumentationWithPreAuth, produce:
  Let claim be Claim with claimId set to "C9", patientId set to "P1", providerId set to "PR9", serviceDate set to "2026-01-15", amount set to 5000, diagnosisCode set to "K35".
  Return validateClaimDocumentation(claim, true, true).
Rule testInvalidDocumentationNoPreAuth, produce:
  Let claim be Claim with claimId set to "C10", patientId set to "P1", providerId set to "PR10", serviceDate set to "2026-01-15", amount set to 5000, diagnosisCode set to "K35".
  Return validateClaimDocumentation(claim, false, true).
Rule testInvalidDocumentationNoReferral, produce:
  Let claim be Claim with claimId set to "C11", patientId set to "P1", providerId set to "PR11", serviceDate set to "2026-01-15", amount set to 5000, diagnosisCode set to "K35".
  Return validateClaimDocumentation(claim, true, false).
Rule testLowAmountNoPreAuthRequired, produce:
  Let claim be Claim with claimId set to "C12", patientId set to "P1", providerId set to "PR12", serviceDate set to "2026-01-15", amount set to 200, diagnosisCode set to "Z00".
  Return validateClaimDocumentation(claim, false, true).
Rule testCalculateClaimApprovalGeneral, produce:
  Return calculateClaimApproval(1000, 80, "general").
Rule testCalculateClaimApprovalSpecialist, produce:
  Return calculateClaimApproval(1000, 80, "specialist").
Rule testCalculateClaimApprovalSurgery, produce:
  Return calculateClaimApproval(1000, 80, "surgery").
