Rule testCalculateBaseRateYoungShort, produce:
  Return calculateBaseRate(25, 10).
Rule testCalculateBaseRateYoungLong, produce:
  Return calculateBaseRate(25, 30).
Rule testCalculateBaseRateMiddleShort, produce:
  Return calculateBaseRate(40, 10).
Rule testCalculateBaseRateMiddleLong, produce:
  Return calculateBaseRate(40, 30).
Rule testCalculateBaseRateOlderShort, produce:
  Return calculateBaseRate(50, 10).
Rule testCalculateBaseRateOlderLong, produce:
  Return calculateBaseRate(50, 30).
Rule testCalculateBaseRateSeniorShort, produce:
  Return calculateBaseRate(60, 10).
