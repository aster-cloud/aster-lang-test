{
  "policy": "tier1-equivalence/policies/stdlib_collections.aster",
  "entry": "mapId",
  "cases": [
    {
      "name": "map identity over list",
      "input": [
        [
          1,
          2,
          3
        ]
      ],
      "expectedOutput": [
        1,
        2,
        3
      ]
    },
    {
      "name": "length of 3",
      "entry": "length",
      "input": [
        [
          10,
          20,
          30
        ]
      ],
      "expectedOutput": 3
    },
    {
      "name": "length of empty",
      "entry": "length",
      "input": [
        []
      ],
      "expectedOutput": 0
    },
    {
      "name": "max of positives",
      "entry": "maxOf",
      "input": [
        [
          3,
          9,
          4
        ]
      ],
      "expectedOutput": 9
    },
    {
      "name": "max with negatives",
      "entry": "maxOf",
      "input": [
        [
          -5,
          -2,
          -9
        ]
      ],
      "expectedOutput": -2
    },
    {
      "name": "max of single",
      "entry": "maxOf",
      "input": [
        [
          7
        ]
      ],
      "expectedOutput": 7
    },
    {
      "name": "min of positives",
      "entry": "minOf",
      "input": [
        [
          3,
          9,
          4
        ]
      ],
      "expectedOutput": 3
    },
    {
      "name": "min with negatives",
      "entry": "minOf",
      "input": [
        [
          -5,
          -2,
          -9
        ]
      ],
      "expectedOutput": -9
    },
    {
      "name": "min of single",
      "entry": "minOf",
      "input": [
        [
          7
        ]
      ],
      "expectedOutput": 7
    },
    {
      "name": "C(4,2)=6",
      "entry": "combosCount",
      "input": [
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expectedOutput": 6
    },
    {
      "name": "C(2,2)=1",
      "entry": "combosCount",
      "input": [
        [
          1,
          2
        ]
      ],
      "expectedOutput": 1
    },
    {
      "name": "C(1,2)=0 不足则无组合",
      "entry": "combosCount",
      "input": [
        [
          1
        ]
      ],
      "expectedOutput": 0
    },
    {
      "name": "head returns None",
      "entry": "head",
      "input": [
        [
          1,
          2,
          3
        ]
      ],
      "expectedOutput": {
        "__type": "None"
      }
    }
  ]
}
