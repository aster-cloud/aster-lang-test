{
  "policy": "tier1-equivalence/policies/struct_list_equality.aster",
  "entry": "samePoint",
  "cases": [
    {
      "name": "字段全同的两个结构体 → true（结构相等，非引用相等）",
      "input": [
        1,
        2,
        1,
        2
      ],
      "expectedOutput": true
    },
    {
      "name": "第二个字段不同 → false",
      "input": [
        1,
        2,
        1,
        3
      ],
      "expectedOutput": false
    },
    {
      "name": "第一个字段不同 → false",
      "input": [
        1,
        2,
        9,
        2
      ],
      "expectedOutput": false
    },
    {
      "name": "内容相同的两个列表 → true",
      "input": [
        4,
        4
      ],
      "expectedOutput": true,
      "entry": "sameList"
    },
    {
      "name": "长度不同的列表 → false",
      "input": [
        4,
        5
      ],
      "expectedOutput": false,
      "entry": "sameList"
    }
  ]
}
