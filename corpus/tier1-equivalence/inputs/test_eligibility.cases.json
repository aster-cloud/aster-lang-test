{
  "policy": "tier1-equivalence/policies/test_eligibility.aster",
  "entry": "determineMinorCoverage",
  "cases": [
    {
      "name": "未成年 premium = 100",
      "input": [
        "premium",
        0
      ],
      "expectedOutput": 100
    },
    {
      "name": "未成年 standard = 90",
      "input": [
        "standard",
        0
      ],
      "expectedOutput": 90
    },
    {
      "name": "未成年 未知档落兜底 80",
      "input": [
        "gold",
        0
      ],
      "expectedOutput": 80
    },
    {
      "name": "★原 stub golden 同输入：现返回 80（旧 golden 断言 0，那是占位值）",
      "input": [
        "basic",
        {
          "basePrice": 100
        }
      ],
      "expectedOutput": 80
    },
    {
      "name": "老年 medicare = 95（最高）",
      "entry": "determineSeniorCoverage",
      "input": [
        "medicare",
        0
      ],
      "expectedOutput": 95
    },
    {
      "name": "老年 premium = 90",
      "entry": "determineSeniorCoverage",
      "input": [
        "premium",
        0
      ],
      "expectedOutput": 90
    },
    {
      "name": "老年 standard = 80",
      "entry": "determineSeniorCoverage",
      "input": [
        "standard",
        0
      ],
      "expectedOutput": 80
    },
    {
      "name": "老年 未知档落兜底 70",
      "entry": "determineSeniorCoverage",
      "input": [
        "basic",
        0
      ],
      "expectedOutput": 70
    },
    {
      "name": "★标准 premium 慢病≥2 = 90（慢病加保）",
      "entry": "determineStandardCoverage",
      "input": [
        "premium",
        0,
        2
      ],
      "expectedOutput": 90
    },
    {
      "name": "★标准 premium 慢病=1 = 85（恰在边界下方）",
      "entry": "determineStandardCoverage",
      "input": [
        "premium",
        0,
        1
      ],
      "expectedOutput": 85
    },
    {
      "name": "标准 standard 慢病≥2 = 80",
      "entry": "determineStandardCoverage",
      "input": [
        "standard",
        0,
        3
      ],
      "expectedOutput": 80
    },
    {
      "name": "标准 standard 慢病=0 = 70",
      "entry": "determineStandardCoverage",
      "input": [
        "standard",
        0,
        0
      ],
      "expectedOutput": 70
    },
    {
      "name": "标准 basic = 60（不受慢病影响）",
      "entry": "determineStandardCoverage",
      "input": [
        "basic",
        0,
        5
      ],
      "expectedOutput": 60
    },
    {
      "name": "标准 未知档落兜底 50",
      "entry": "determineStandardCoverage",
      "input": [
        "gold",
        0,
        0
      ],
      "expectedOutput": 50
    },
    {
      "name": "自付额 200×80% → 40",
      "entry": "calculatePatientCost",
      "input": [
        200,
        80
      ],
      "expectedOutput": 40
    },
    {
      "name": "★零覆盖 → 全额自付 200",
      "entry": "calculatePatientCost",
      "input": [
        200,
        0
      ],
      "expectedOutput": 200
    },
    {
      "name": "★全覆盖 → 自付 0",
      "entry": "calculatePatientCost",
      "input": [
        200,
        100
      ],
      "expectedOutput": 0
    },
    {
      "name": "★非整除：150×85% → 22.5（divided by 是真除法）",
      "entry": "calculatePatientCost",
      "input": [
        150,
        85
      ],
      "expectedOutput": 22.5
    },
    {
      "name": "★无保险：不合格、覆盖 0、全额自付",
      "entry": "checkServiceEligibility",
      "input": [
        {
          "patientId": "P-1",
          "age": 40,
          "hasInsurance": false,
          "insuranceType": "none",
          "chronicConditions": 0
        },
        {
          "serviceCode": "S-1",
          "serviceName": "Consult",
          "basePrice": 200,
          "requiresPreAuth": false
