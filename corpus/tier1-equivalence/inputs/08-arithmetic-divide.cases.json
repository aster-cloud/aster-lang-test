{
  "policy": "tier1-equivalence/policies/08-arithmetic-divide.aster",
  "entry": "divide",
  "cases": [
    {
      "name": "20 / 4 = 5",
      "input": [
        20,
        4
      ],
      "expectedOutput": 5
    },
    {
      "name": "7 / 2 = 3.5",
      "input": [
        7,
        2
      ],
      "expectedOutput": 3.5
    },
    {
      "name": "100 / 10 = 10",
      "input": [
        100,
        10
      ],
      "expectedOutput": 10
    },
    {
      "name": "除零 10 / 0 → 两引擎都必须拒绝",
      "input": [
        10,
        0
      ],
      "expectError": true
    },
    {
      "name": "除零 0 / 0 → 两引擎都必须拒绝",
      "input": [
        0,
        0
      ],
      "expectError": true
    }
  ]
}
