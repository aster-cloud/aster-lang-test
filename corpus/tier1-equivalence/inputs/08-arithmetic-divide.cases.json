{
  "policy": "tier1-equivalence/policies/08-arithmetic-divide.aster",
  "entry": "divide",
  "cases": [
    {
      "name": "20 / 4 = 5",
      "input": [
        20,
        4
      ],
      "expectedOutput": 5
    },
    {
      "name": "7 / 2 = 3.5",
      "input": [
        7,
        2
      ],
      "expectedOutput": 3.5
    },
    {
      "name": "100 / 10 = 10",
      "input": [
        100,
        10
      ],
      "expectedOutput": 10
    },
    {
      "name": "★200/3 无限小数：两引擎浮点表示逐位一致",
      "input": [
        200,
        3
      ],
      "expectedOutput": 66.66666666666667
    },
    {
      "name": "★1/3 无限小数",
      "input": [
        1,
        3
      ],
      "expectedOutput": 0.3333333333333333
    },
    {
      "name": "★极大数 1e15/7：该量级下 double 间距已超过 0.01",
      "input": [
        1000000000000000,
        7
      ],
      "expectedOutput": 142857142857142.84
    },
    {
      "name": "★负数除法保号",
      "input": [
        -7,
        2
      ],
      "expectedOutput": -3.5
    },
    {
      "name": "★除数为负",
      "input": [
        7,
        -2
      ],
      "expectedOutput": -3.5
    }
  ]
}
