{
  "policy": "tier1-equivalence/policies/patient-record.aster",
  "entry": "verify_consent",
  "cases": [
    {
      "name": "同意: 无同意 -> 无效",
      "input": [
        {
          "requester_id": "X",
          "requester_role": "physician",
          "purpose": "treatment",
          "patient_id": "P-1",
          "has_consent": false
        }
      ],
      "expectedOutput": {
        "__type": "ConsentResult",
        "is_valid": false,
        "reason": "Patient consent not obtained"
      }
    },
    {
      "name": "同意: 有同意但目的为空 -> 无效",
      "input": [
        {
          "requester_id": "X",
          "requester_role": "physician",
          "purpose": "",
          "patient_id": "P-1",
          "has_consent": true
        }
      ],
      "expectedOutput": {
        "__type": "ConsentResult",
        "is_valid": false,
        "reason": "Purpose of access not specified"
      }
    },
    {
      "name": "同意: 有同意且目的明确 -> 有效",
      "input": [
        {
          "requester_id": "X",
          "requester_role": "physician",
          "purpose": "treatment",
          "patient_id": "P-1",
          "has_consent": true
        }
      ],
      "expectedOutput": {
        "__type": "ConsentResult",
        "is_valid": true,
        "reason": "Consent verified"
      }
    },
    {
      "name": "最小必要: 医生看到诊断",
      "entry": "get_patient_summary",
      "input": [
        {
          "requester_id": "DR-1",
          "requester_role": "physician",
          "purpose": "treatment",
          "patient_id": "P-1",
          "has_consent": true
        },
        {
          "patient_id": "P-1",
          "name": "John Doe",
          "ssn": "123-45-6789",
          "date_of_birth": "1990-01-01",
          "diagnosis": "Hypertension",
          "treatment_plan": "Medication daily",
          "insurance_id": "INS-1"
        }
      ],
      "expectedOutput": {
        "__type": "Ok",
        "value": {
          "__type": "PatientSummary",
          "patient_id": "P-1",
          "display_info": "John Doe - Hypertension"
        }
      }
    },
    {
      "name": "最小必要: 账单只看到保险号（★不含诊断）",
      "entry": "get_patient_summary",
      "input": [
        {
          "requester_id": "B-1",
          "requester_role": "billing",
          "purpose": "payment",
          "patient_id": "P-1",
          "has_consent": true
        },
        {
          "patient_id": "P-1",
          "name": "John Doe",
          "ssn": "123-45-6789",
          "date_of_birth": "1990-01-01",
          "diagnosis": "Hypertension",
          "treatment_plan": "Medication daily",
          "insurance_id": "INS-1"
        }
      ],
      "expectedOutput": {
        "__type": "Ok",
        "value": {
          "__type": "PatientSummary",
          "patient_id": "P-1",
          "display_info": "P-1 - INS-1"
        }
      }
    },
    {
      "name": "最小必要: 护士看到治疗方案",
      "entry": "get_patient_summary",
      "input": [
        {
          "requester_id": "N-1",
          "requester_role": "nurse",
          "purpose": "treatment",
          "patient_id": "P-1",
          "has_consent": true
        },
        {
          "patient_id": "P-1",
          "name": "John Doe",
          "ssn": "123-45-6789",
          "date_of_birth": "1990-01-01",
          "diagnosis": "Hypertension",
          "treatment_plan": "Medication daily",
          "insurance_id": "INS-1"
        }
      ],
      "expectedOutput": {
        "__type": "Ok",
        "value": {
          "__type": "PatientSummary",
          "patient_id": "P-1",
          "display_info": "John Doe - Medication daily"
        }
      }
    },
    {
      "name": "★无同意 -> err（此前是死代码）",
      "entry": "get_patient_summary",
      "input": [
        {
          "requester_id": "A-1",
          "requester_role": "admin",
          "purpose": "curiosity",
          "patient_id": "P-1",
          "has_consent": false
        },
        {
          "patient_id": "P-1",
          "name": "John Doe",
          "ssn": "123-45-6789",
          "date_of_birth": "1990-01-01",
          "diagnosis": "Hypertension",
          "treatment_plan": "Medication daily",
          "insurance_id": "INS-1"
        }
      ],
      "expectedOutput": {
        "__type": "Err",
        "value": "Patient consent not obtained"
      }
    },
    {
      "name": "★有同意但角色未授权 -> err",
      "entry": "get_patient_summary",
      "input": [
        {
          "requester_id": "Z-1",
          "requester_role": "janitor",
          "purpose": "treatment",
          "patient_id": "P-1",
          "has_consent": true
        },
        {
          "patient_id": "P-1",
          "name": "John Doe",
          "ssn": "123-45-6789",
          "date_of_birth": "1990-01-01",
          "diagnosis": "Hypertension",
          "treatment_plan": "Medication daily",
          "insurance_id": "INS-1"
        }
      ],
      "expectedOutput": {
        "__type": "Err",
        "value": "Access denied: insufficient role"
      }
    },
    {
      "name": "demo: 合规访问（零参打通全链）",
      "entry": "demo_compliant_access",
      "input": [],
      "expectedOutput": {
        "__type": "Ok",
        "value": {
          "__type": "PatientSummary",
          "patient_id": "P-001",
          "display_info": "John Doe - Hypertension"
        }
      }
    },
    {
      "name": "demo: ★无同意的 admin 窥私被拒",
      "entry": "demo_non_compliant_access",
      "input": [],
      "expectedOutput": {
        "__type": "Err",
        "value": "Patient consent not obtained"
      }
    },
    {
      "name": "★脱敏显示：姓名与 SSN 均被掩码",
      "entry": "display_patient_safe",
      "input": [
        {
          "patient_id": "P-1",
          "name": "John Doe",
          "ssn": "123-45-6789",
          "date_of_birth": "1990-01-01",
          "diagnosis": "Hypertension",
          "treatment_plan": "Medication daily",
          "insurance_id": "INS-1"
        }
      ],
      "expectedOutput": "Patient: [REDACTED], SSN: [REDACTED]"
    },
    {
      "name": "redact 全掩码",
      "entry": "redact",
      "input": [
        "John Doe"
      ],
      "expectedOutput": "[REDACTED]"
    }
  ]
}
