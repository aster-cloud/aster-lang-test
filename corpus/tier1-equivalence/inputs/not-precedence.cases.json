{
  "policy": "tier1-equivalence/policies/not-precedence.aster",
  "entry": "notCompare",
  "cases": [
    {
      "name": "not (5 > 3) = false",
      "input": [
        5,
        3
      ],
      "expectedOutput": false
    },
    {
      "name": "not (3 > 5) = true",
      "input": [
        3,
        5
      ],
      "expectedOutput": true
    },
    {
      "name": "notNot true",
      "entry": "notNot",
      "input": [
        true
      ],
      "expectedOutput": true
    },
    {
      "name": "notNot false",
      "entry": "notNot",
      "input": [
        false
      ],
      "expectedOutput": false
    },
    {
      "name": "notAnd: not(1>0) and 1>0 → false",
      "entry": "notAnd",
      "input": [
        1,
        1
      ],
      "expectedOutput": false
    },
    {
      "name": "notAnd: not(-1>0) and 1>0 → true",
      "entry": "notAnd",
      "input": [
        -1,
        1
      ],
      "expectedOutput": true
    },
    {
      "name": "notAnd: not(-1>0) and -1>0 → false",
      "entry": "notAnd",
      "input": [
        -1,
        -1
      ],
      "expectedOutput": false
    }
  ]
}
