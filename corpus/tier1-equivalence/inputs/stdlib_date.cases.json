      ],
      "expectedOutput": -60
    },
    {
      "name": "同日 → 0",
      "input": [
        "2024-01-01",
        "2024-01-01"
      ],
      "expectedOutput": 0
    },
    {
      "name": "跨闰日 2024-02-28 → 2024-03-01 = 2 天",
      "input": [
        "2024-02-28",
        "2024-03-01"
      ],
      "expectedOutput": 2
    },
    {
      "name": "跨年 2023-12-31 → 2024-01-01 = 1 天",
      "input": [
        "2023-12-31",
        "2024-01-01"
      ],
      "expectedOutput": 1
    }
  ]
}
