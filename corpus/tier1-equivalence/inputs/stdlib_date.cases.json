{
  "policy": "tier1-equivalence/policies/stdlib_date.aster",
  "entry": "spanDays",
  "cases": [
    {
      "name": "2024-01-01 → 2024-03-01 = 60",
      "input": [
        "2024-01-01",
        "2024-03-01"
      ],
      "expectedOutput": 60
    },
    {
      "name": "反向区间 = -60",
      "input": [
        "2024-03-01",
        "2024-01-01"
      ],
      "expectedOutput": -60
    },
    {
      "name": "同日 = 0",
      "input": [
        "2024-01-01",
        "2024-01-01"
      ],
      "expectedOutput": 0
    },
    {
      "name": "闰年 2024-02-28 → 03-01 = 2",
      "input": [
        "2024-02-28",
        "2024-03-01"
      ],
      "expectedOutput": 2
    },
    {
      "name": "跨年 2023-12-31 → 2024-01-01 = 1",
      "input": [
        "2023-12-31",
        "2024-01-01"
      ],
      "expectedOutput": 1
    },
    {
      "name": "parseDate: 非 ISO 串 → 两引擎都必须拒绝",
      "entry": "parseDate",
      "input": [
        "not-a-date"
      ],
      "expectError": true
    },
    {
      "name": "parseDate: 月/日越界 2026-13-45 → 两引擎都必须拒绝",
      "entry": "parseDate",
      "input": [
        "2026-13-45"
      ],
      "expectError": true
    },
    {
      "name": "yearOf: 非法 ISO 经 Date.year 传播 → 两引擎都必须拒绝",
      "entry": "yearOf",
      "input": [
        "garbage"
      ],
      "expectError": true
    },
    {
      "name": "spanDays: 第二参数非法 ISO → 两引擎都必须拒绝",
      "entry": "spanDays",
      "input": [
        "2026-01-01",
        "bad"
      ],
      "expectError": true
    },
    {
      "name": "提取日",
      "input": [
        "2026-03-15"
      ],
      "expectedOutput": 15,
      "entry": "dayOf"
    },
    {
      "name": "提取月份",
      "input": [
        "2026-03-15"
      ],
      "expectedOutput": 3,
      "entry": "monthOf"
    },
    {
      "name": "2026-03-15 → epoch-day（自 1970-01-01 的天数）",
      "input": [
        "2026-03-15"
      ],
      "expectedOutput": 20527,
      "entry": "parseDate"
    },
    {
      "name": "addDays 20 天：20527 + 20",
      "input": [
        "2026-03-15",
        20
      ],
      "expectedOutput": 20547,
      "entry": "shift"
    },
    {
      "name": "2/1→3/15 共 42 天，at least 30 成立",
      "input": [
        "2026-03-15",
        "2026-02-01"
      ],
      "expectedOutput": true,
      "entry": "waitElapsed"
    },
    {
      "name": "提取年份",
      "input": [
        "2026-03-15"
      ],
      "expectedOutput": 2026,
      "entry": "yearOf"
    }
  ]
}
